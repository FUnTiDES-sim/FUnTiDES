{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Edit", "Write",
      "Bash(git status:*)", "Bash(git log:*)", "Bash(git ls-files:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git checkout -- :*)",
      "Bash(grep:*)", "Bash(xargs wc:*)", "Bash(echo:*)",
      "Bash(scripts/check_comments_only.sh:*)"
    ],
    "deny": [
      "Bash(git push:*)", "Bash(git reset:*)", "Bash(git rebase:*)",
      "Bash(git stash:*)", "Bash(git checkout main:*)", "Bash(rm:*)"
    ]
  }
}
