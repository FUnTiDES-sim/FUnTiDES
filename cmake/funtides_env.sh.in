# FUnTiDES environment, generated by CMake and installed with FUnTiDES.
#
# Usage (e.g. at the end of ~/.bashrc):
#   source @CMAKE_INSTALL_PREFIX@/funtides_env.sh
#
# It loads the TPL environment (Kokkos, ADIOS2, Python venv), then makes the
# FUnTiDES libraries, CMake package and Python package visible. It can be
# sourced several times without duplicating entries.

# Prepend $2 to the variable named $1, unless already present
_funtides_prepend() {
    case ":${!1}:" in
        *":$2:"*) ;;
        *) export "$1=$2${!1:+:${!1}}" ;;
    esac
}

# Third-party libraries and their Python virtual environment
_FUNTIDES_TPL_ENV="@FUNTIDES_TPL_ENV_SCRIPT@"
if [ -n "${_FUNTIDES_TPL_ENV}" ] && [ -f "${_FUNTIDES_TPL_ENV}" ]; then
    source "${_FUNTIDES_TPL_ENV}" > /dev/null
fi

# FUnTiDES itself (located from this script, so the install tree can be moved)
export FUNTIDES_INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_funtides_prepend PATH "${FUNTIDES_INSTALL_DIR}/bin"
_funtides_prepend LD_LIBRARY_PATH "${FUNTIDES_INSTALL_DIR}/lib"
_funtides_prepend CMAKE_PREFIX_PATH "${FUNTIDES_INSTALL_DIR}"
@FUNTIDES_ENV_PYTHONPATH@

unset -f _funtides_prepend
unset _FUNTIDES_TPL_ENV
