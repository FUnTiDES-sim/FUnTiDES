@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Kokkos is searched first where FUnTiDES was built against it.
find_dependency(Kokkos HINTS "@Kokkos_DIR@")

if(@USE_MPI@)
  find_dependency(MPI)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/funtidesTargets.cmake")

check_required_components(funtides)
